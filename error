                await window.APIClient.deactivateTrader();
                
                this.isTrader = false;
                Alpine.store('profile').showNotification('Trader account deactivated successfully', 'success');
                
                this.traderData = {
                    display_name: '',
                    bio: '',
                    risk_score: 5,
                    minimum_investment: 100.00,
                    total_followers: 0,
                    total_trades: 0,
                    win_rate: 0
                };
            } catch (error) {
                console.error('Error deactivating trader:', error);
                Alpine.store('profile').showNotification(error.message || 'Failed to deactivate trader account', 'error');
            } finally {
                this.deactivating = false;
            }
        }
    }));
    
    console.log('Alpine components registered successfully');
}

