                    `).join('');
                    }

                    // Populate slides
                    const expertSlides = document.querySelectorAll('#topExperts .swiper-slide');
                    const leaderSlides = document.querySelectorAll('#topTraders .swiper-slide');
                    const topExperts = data.topExperts.slice(0, 3);
