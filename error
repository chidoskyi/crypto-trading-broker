    <script>
        // --- Utility: String to numeric seed ---
        function stringToSeed(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = (hash << 5) - hash + str.charCodeAt(i);
                hash |= 0;
            }
            return Math.abs(hash);
        }

        // --- Seeded PRNG using Linear Congruential Generator ---
        function seededRandomGenerator(seed) {
            let m = 2 ** 31 - 1;
            let a = 16807;
            let state = seed % m;
            return function () {
                state = (a * state) % m;
                return state / m;
            };
        }

        // --- Generate ROI data with labels (dates) ---
        function generateSmoothSeededROI(seedString, startDate, days = 365, startROI = 0) {
            const seed = stringToSeed(seedString);
            const random = seededRandomGenerator(seed);
            const data = [];
            const labels = [];
            let currentROI = startROI;

            const bias = 0.01; // very small daily positive bias
            const volatility = 0.1; // smaller daily volatility for smoothness
            const smoothingFactor = 0.3; // smooth factor for moving average

            let lastChange = 0;

            for (let i = 0; i < days; i++) {
                const date = new Date(startDate);
                date.setDate(date.getDate() + i);
                labels.push(date.toISOString().split('T')[0]);

                // Generate noisy daily change with bias
                let rawChange = ((random() - 0.5) * volatility) + bias;

                // Smooth changes: mix last day's change with current raw change
                const smoothedChange = smoothingFactor * rawChange + (1 - smoothingFactor) * lastChange;

                currentROI += smoothedChange;
                lastChange = smoothedChange;

                // Optional: clamp to prevent large negatives
                if (currentROI < -0.2) currentROI = -0.2;

                data.push(parseFloat(currentROI.toFixed(2)));
            }

            return {
                labels,
                data
            };
        }


        // --- Store chart instances by canvas ID ---
        const roiCharts = {};

        // --- Create chart in canvas with given ID and seed ---
        function drawChart(selector, seedValue) {
            const {
                labels,
                data
            } = generateSmoothSeededROI(seedValue, '2025-01-01');
            const canvases = document.querySelectorAll(selector);
            if (!canvases.length) {
                console.warn(`Canvas not found: ${selector}`);
                return;
            }

            canvases.forEach((canvas, idx) => {
                const ctx = canvas.getContext('2d');
                // Destroy existing chart instance if it exists
                if (roiCharts[selector + idx]) {
                    roiCharts[selector + idx].destroy();
                }
                roiCharts[selector + idx] = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: `ROI - ${seedValue}`,
                            data: data,
                            backgroundColor: 'rgba(255, 159, 64, 0.2)',
                            borderColor: 'rgba(255, 159, 64, 1)',
                            borderWidth: 1,
                            fill: true,
                            tension: 0.2,
                            pointRadius: 0,
                            pointHoverRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: false
                            },
                            title: {
                                display: false
                            },
                            tooltip: {
                                enabled: true
                            }
                        },
                        interaction: {
                            mode: 'nearest',
                            intersect: false
                        },
                        scales: {
                            x: {
                                display: false,
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    display: false
                                },
                            },
                            y: {
                                display: false,
                                grid: {
                                    display: false
                                },
                                ticks: {
                                    display: false
                                },
                                beginAtZero: true
                            }
                        }
                    }
                });
            });
        }

