<script>
(function(){
  const $ = (id)=>document.getElementById(id);
  const root = $('ctc_root');

  // THEME
  function getTheme(){
    const isDark = document.body.classList.contains('dark') || document.body.classList.contains('dark-mode');
    return {
      isDark,
      cardBg:  isDark ? '#1e1e1e' : '#fff',
      border:  isDark ? 'rgba(255,255,255,.15)' : 'rgba(0,0,0,.1)',
      tileBor: isDark ? 'rgba(255,255,255,.12)' : 'rgba(0,0,0,.08)',
      text:    isDark ? '#fff' : '#212529',
      muted:   isDark ? '#aaa' : '#6c757d'
    };
  }
  function applyTheme(){
    const t = getTheme();
    root.style.color = t.text;
    root.querySelectorAll('[data-ctc="card"]').forEach(el=>{
      el.style.background = t.cardBg;
      el.style.border = '1px solid ' + t.border;
    });
    root.querySelectorAll('[data-ctc="tile"]').forEach(el=>{
      el.style.border = '1px solid ' + t.tileBor;
      if(!el.style.background) el.style.background = 'transparent';
    });
    root.querySelectorAll('.ctc-strong').forEach(el=> el.style.color = t.text);
    root.querySelectorAll('.ctc-muted').forEach(el=> el.style.color = t.muted);
  }
  const themeObs = new MutationObserver(applyTheme);
  themeObs.observe(document.body,{attributes:true, attributeFilter:['class']});

  // FORMATTERS
  const fmtUSD      = (n)=> isFinite(n) ? `$${Number(n).toLocaleString(undefined,{maximumFractionDigits:2})}` : '—';
  const fmtUSDSign  = (n)=> !isFinite(n) ? '—' : (n>=0 ? `+$${Number(n).toLocaleString(undefined,{maximumFractionDigits:2})}` : `-$${Math.abs(n).toLocaleString(undefined,{maximumFractionDigits:2})}`);
  const fmtNum      = (n,d=8)=> isFinite(n) ? Number(n).toLocaleString(undefined,{maximumFractionDigits:d}) : '—';
  const nowStr      = ()=> new Date().toLocaleTimeString();

  // ELEMENTS
  const els = {
    type: $('ctc_asset_type'),
    side: $('ctc_side'),
    cryptoId: $('ctc_crypto_id'),
    cryptoCustom: $('ctc_crypto_custom'),
    fxBase: $('ctc_fx_base'),
    fxQuote: $('ctc_fx_quote'),
    stockTicker: $('ctc_stock_ticker'),
    livePrice: $('ctc_live_price'),
    lastUpdate: $('ctc_last_update'),
    refresh: $('ctc_refresh'),
    entry: $('ctc_entry'),
    target: $('ctc_target'),
    movePct: $('ctc_move_pct'),
    amount: $('ctc_amount'),
    leverage: $('ctc_leverage'),
    hours: $('ctc_hours'),
    funding: $('ctc_funding'),
    feesBps: $('ctc_fees_bps'),
    slipBps: $('ctc_slip_bps'),
    copies: $('ctc_copies'),
    copyAlloc: $('ctc_copy_alloc'),
    calcBtn: $('ctc_calc'),
    qty: $('ctc_qty'),
    notional: $('ctc_notional'),
    targetMove: $('ctc_target_move'),
    fees: $('ctc_fees'),
    slippage: $('ctc_slippage'),
    fundingCost: $('ctc_funding_cost'),
    grossPnl: $('ctc_gross_pnl'),
    netPnl: $('ctc_net_pnl'),
    netPnlTotal: $('ctc_net_pnl_total')
  };

  // UI
  function syncSymbolUI() {
    const t = els.type.value;
    $('ctc_symbol_crypto').style.display = (t==='crypto') ? '' : 'none';
    $('ctc_symbol_forex').style.display  = (t==='forex')  ? '' : 'none';
    $('ctc_symbol_stock').style.display  = (t==='stock')  ? '' : 'none';
  }
  function currentCryptoId(){
    return (els.cryptoId.value === 'other' && els.cryptoCustom.value.trim())
      ? els.cryptoCustom.value.trim()
      : els.cryptoId.value;
  }

  // PRICE FETCHERS
  async function fetchCryptoUSD(id){
    const url = `https://api.coingecko.com/api/v3/simple/price?ids=${encodeURIComponent(id)}&vs_currencies=usd`;
    const r = await fetch(url); if(!r.ok) throw new Error('coingecko error');
    const j = await r.json();
    return j?.[id]?.usd || null;
  }
  async function fetchForex(base, quote){
    if (base === quote) return 1;
    const url = `https://api.exchangerate.host/latest?base=${encodeURIComponent(base)}&symbols=${encodeURIComponent(quote)}`;
    const r = await fetch(url); if(!r.ok) throw new Error('fx error');
    const j = await r.json();
    return j?.rates?.[quote] || null;
  }
  async function fetchStock(tickerInput){
    const t = (tickerInput||'').trim().toLowerCase();
    if(!t) return null;
    const symbol = t.includes('.') ? t : `${t}.us`;
    const url = `https://stooq.com/q/l/?s=${encodeURIComponent(symbol)}&f=sd2t2ohlcv&h&e=csv`;
    const r = await fetch(url);
    if (!r.ok) throw new Error('stooq error');
    const text = await r.text();
    const lines = text.trim().split('\n');
    if(lines.length < 2) return null;
    const cols = lines[1].split(',');
    const close = parseFloat(cols[6]);
    return isFinite(close) ? close : null;
  }

  async function updateLivePrice(){
    try{
      let price = null;
      const t = els.type.value;
      if (t==='crypto') price = await fetchCryptoUSD(currentCryptoId());
      if (t==='forex')  price = await fetchForex(els.fxBase.value, els.fxQuote.value);
      if (t==='stock')  price = await fetchStock(els.stockTicker.value);

      if (price==null) throw new Error('no price');

      els.livePrice.textContent = fmtUSD(price);
      els.lastUpdate.textContent = `Updated ${nowStr()}`;

      const curEntry = parseFloat(els.entry.value);
      if (!isFinite(curEntry) || curEntry<=0) els.entry.value = price;
      syncTargetFromMovePct(); // keep target in sync
    }catch(e){
      els.livePrice.textContent = '—';
      els.lastUpdate.textContent = 'Price unavailable (enter Entry manually)';
    }
  }
  setInterval(updateLivePrice, 60000); // auto refresh

  // TARGET / % MOVE SYNC (side-aware)
  function syncTargetFromMovePct(){
    const entry = parseFloat(els.entry.value);
    let mPct = parseFloat(els.movePct.value);
    const side = els.side.value;
    if (!isFinite(entry) || entry<=0) return;

    // if both empty/zero, assume 1%
    if ((!isFinite(mPct) || mPct===0) && (!isFinite(parseFloat(els.target.value)) || parseFloat(els.target.value)===0)) {
      mPct = 1;
      els.movePct.value = '1';
    }
    if (!isFinite(mPct)) return;

    const tgt = side==='long'
      ? entry * (1 + mPct/100)
      : entry * (1 - mPct/100);
    els.target.value = String(tgt);
  }
  function syncMovePctFromTarget(){
    const entry = parseFloat(els.entry.value);
    const tgt   = parseFloat(els.target.value);
    const side  = els.side.value;
    if (!isFinite(entry) || entry<=0 || !isFinite(tgt)) return;

    const pct = side==='long'
      ? ((tgt - entry) / entry) * 100
      : ((entry - tgt) / entry) * 100;
    els.movePct.value = pct.toFixed(2);
  }

  // CALCULATE
  function calculate(){
    const side    = els.side.value; // long | short
    const entry   = parseFloat(els.entry.value);
    let   target  = parseFloat(els.target.value);
    let   movePct = parseFloat(els.movePct.value);
    let   amount  = parseFloat(els.amount.value);
    const lev     = Math.max(1, parseFloat(els.leverage.value)||1);
    const hours   = Math.max(0, parseFloat(els.hours.value)||0);
    const fundingPctPer8h = Math.max(0, parseFloat(els.funding.value)||0);
    const feesBps = Math.max(0, parseFloat(els.feesBps.value)||0);
    const slipBps = Math.max(0, parseFloat(els.slipBps.value)||0);
    const copies  = Math.max(1, parseInt(els.copies.value)||1);
    const perCopy = Math.max(0, parseFloat(els.copyAlloc.value)||0);

    if (!isFinite(amount) || amount<=0) amount = copies * perCopy;
    if (!isFinite(entry) || entry<=0){ alert('Please provide a valid Entry Price.'); return; }

    // default 1% if neither provided
    if ((!isFinite(target) || target===0) && (!isFinite(movePct) || movePct===0)) {
      movePct = 1;
      els.movePct.value = '1';
    }
    if (!isFinite(target) || target===0) {
      target = side==='long' ? entry*(1+movePct/100) : entry*(1-movePct/100);
      els.target.value = String(target);
    }
    if (!isFinite(movePct) || movePct===0){
      movePct = side==='long' ? ((target-entry)/entry)*100 : ((entry-target)/entry)*100;
      els.movePct.value = movePct.toFixed(2);
    }

    const qty = (amount * lev) / entry;
    const notional = qty * entry;

    const fees     = notional * (feesBps/10000);
    const slippage = notional * (slipBps/10000);
    const funding  = notional * ((fundingPctPer8h/100) * (hours/8));

    const grossPnl = side==='long'
      ? qty * (target - entry)
      : qty * (entry - target);

    const netPnlPerCopy = grossPnl - fees - slippage - funding;
    const netTotal = netPnlPerCopy * copies;

    els.qty.textContent        = fmtNum(qty, 6);
    els.notional.textContent   = fmtUSD(notional);
    els.targetMove.textContent = `${movePct.toFixed(2)}%`;
    els.fees.textContent       = fmtUSD(fees);
    els.slippage.textContent   = fmtUSD(slippage);
    els.fundingCost.textContent= fmtUSD(funding);
    els.grossPnl.textContent   = fmtUSDSign(grossPnl);

    const color = netPnlPerCopy >= 0 ? '#16a34a' : '#dc2626';
    els.netPnl.style.color = color;
    els.netPnl.textContent = fmtUSDSign(netPnlPerCopy);
    els.netPnlTotal.style.color = color;
    els.netPnlTotal.textContent = fmtUSDSign(netTotal);
  }

  // EVENTS
  $('ctc_asset_type').addEventListener('change', ()=>{ syncSymbolUI(); updateLivePrice(); });
  $('ctc_side').addEventListener('change', ()=>{ syncTargetFromMovePct(); });
  $('ctc_crypto_id').addEventListener('change', ()=>{
    const showCustom = (els.cryptoId.value === 'other');
    els.cryptoCustom.style.display = showCustom ? '' : 'none';
    updateLivePrice();
  });
  $('ctc_crypto_custom').addEventListener('input', updateLivePrice);
  $('ctc_fx_base').addEventListener('change', updateLivePrice);
  $('ctc_fx_quote').addEventListener('change', updateLivePrice);
  $('ctc_stock_ticker').addEventListener('change', updateLivePrice);
  $('ctc_refresh').addEventListener('click', updateLivePrice);

  ['ctc_entry','ctc_target'].forEach(id=>{
    $(id).addEventListener('input', ()=>{
      if (id==='ctc_entry') syncTargetFromMovePct(); else syncMovePctFromTarget();
    });
  });
  $('ctc_move_pct').addEventListener('input', syncTargetFromMovePct);
  $('ctc_calc').addEventListener('click', calculate);

  // INIT
  applyTheme();
  syncSymbolUI();
  updateLivePrice();
})();
</script>
