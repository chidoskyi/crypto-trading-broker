async function completeTradeFlow() {
    try {
        // Step 1: Check trading summary
        console.log('1. Checking account...');
        const summary = await getTradingSummary();
        
        if (summary.account.trading_balance < 1000) {
            console.error('Insufficient trading balance!');
            return;
        }
        
        // Step 2: Get current price
        console.log('2. Getting BTC price...');
        const ticker = await getTickerData(1); // BTC/USD pair
        const currentPrice = parseFloat(ticker.ticker.last_price);
        console.log(`Current BTC price: $${currentPrice}`);
        
        // Step 3: Place buy order with leverage
        console.log('3. Placing buy order...');
        const buyOrder = await createBuyOrder();
        console.log(`Order filled at: $${buyOrder.order.average_price}`);
        
        // Step 4: Set stop loss and take profit
        console.log('4. Setting stop loss and take profit...');
        const positions = await getPositions();
        const btcPosition = positions.results[0]; // Assuming first position is BTC
        
        const stopLoss = currentPrice * 0.95;  // 5% stop loss
        const takeProfit = currentPrice * 1.10; // 10% take profit
        
        await updateStopLoss(btcPosition.id, stopLoss);
        await updateTakeProfit(btcPosition.id, takeProfit);
        
        console.log('Trade setup complete!');
        console.log(`Stop Loss: $${stopLoss}`);
        console.log(`Take Profit: $${takeProfit}`);
        
    } catch (error) {
        console.error('Trade flow error:', error);
    }
}



