          <p class="text-red-600 dark:text-red-400 mb-4" x-text="error"></p>
          <button @click="loadTradingPairs()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg">
            Retry
          </button>
        </div>
      </div>

      <!-- No Results -->
      <div x-show="!loading && !error && filteredInstruments.length === 0" class="text-center py-12">
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-8">
          <i data-lucide="search-x" class="w-16 h-16 text-gray-400 mx-auto mb-4"></i>
