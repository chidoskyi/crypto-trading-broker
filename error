<script>
// ===== One-card carousel generator (light only, 30s) =====
(function(){
  const hasSwiper = typeof window.Swiper !== "undefined";
  const ri=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
  const pick=a=>a[ri(0,a.length-1)];
  const fmt=n=>n.toLocaleString();

  const pref=["Alpha","Zen","Crypto","Bull","Nova","Apex","Vortex","Echo","Falcon","Orion","Atlas"];
  const suf=["Trader","Master","Pilot","Rider","Hawk","Wolf","Ninja","Guru","Spark","Flow","Edge"];
  const genName=()=>`${pick(pref)}${pick(suf)}${ri(10,9999)}`;

  const genRating=()=>((35+ri(0,15))/10).toFixed(1);
  const stars=r=>{
    r=parseFloat(r);
    let s="";for(let i=0;i<Math.floor(r);i++)s+='<span style="color:#FDBA00">★</span>';
    for(let i=Math.floor(r);i<5;i++)s+='<span style="color:#BDBDBD">☆</span>';
    return s;
  };

  const avatar=(n)=>{
    const h=ri(0,359), s=ri(60,75), l=ri(45,65);
    return `<div style="width:36px;height:36px;border-radius:999px;
                 display:flex;align-items:center;justify-content:center;
                 font-weight:700;font-size:12px;
                 background:hsl(${h} ${s}% ${l}%);color:#fff;">
              ${n.slice(0,2).toUpperCase()}
            </div>`;
  };

  function cardHTML(){
    const name=genName();
    const copyAmt=ri(20000,30000);
    const followers=ri(300,40000);
    const rating=genRating();

    return `
      <div style="height:160px;border:1px solid rgba(0,0,0,.1);
                  border-radius:12px;padding:14px;background:#fff;
                  display:flex;flex-direction:column;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:10px;">
          ${avatar(name)}
          <div style="font-weight:700;color:#212529">${name}</div>
        </div>
        <div style="display:flex;justify-content:space-between;">
          <div>
            <div style="font-size:12px;color:#6c757d;">Copy</div>
            <div style="font-weight:600;color:#212529">${fmt(copyAmt)}</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:12px;color:#6c757d;">Followers</div>
            <div style="font-weight:600;color:#212529">${fmt(followers)}</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
          <div>${stars(rating)}</div>
          <div style="font-size:12px;color:#6c757d;">(${rating})</div>
        </div>
      </div>`;
  }

  function makeSlide(){
    const el=document.createElement('div');
    el.className='swiper-slide';
    el.innerHTML=cardHTML();
    return el;
  }

  function seed(wrapper){
    wrapper.innerHTML="";
    wrapper.appendChild(makeSlide());
  }

  const groups=[{id:"topTraders",swiper:null},{id:"topExperts",swiper:null}];

  groups.forEach((g,i)=>{
    const wrap=document.getElementById(g.id);
    if(!wrap)return;
    seed(wrap);
    if(hasSwiper){
      const cont=wrap.closest(".swiper");
      g.swiper=new Swiper(cont,{slidesPerView:1,loop:true});
      groups[i]=g;
    }
  });

  function refresh(g){
    const wrap=document.getElementById(g.id);
    if(!wrap)return;
    wrap.innerHTML="";
    wrap.appendChild(makeSlide());
    if(g.swiper){g.swiper.update();}
  }

  // refresh every 30s
  setInterval(()=>groups.forEach(refresh),30000);
})();
</script>
